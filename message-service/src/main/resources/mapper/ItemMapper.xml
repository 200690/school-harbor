<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.harbor.messageservice.mapper.ItemMapper">

    <select id="selectByItemId" resultType="com.harbor.messageservice.domain.po.UserItemPostsPO">
        SELECT * FROM user_item_posts WHERE item_id = #{itemId}
    </select>

    <delete id="deleteByItemId">
        DELETE FROM user_item_posts WHERE item_id = #{itemId}
    </delete>

</mapper>
